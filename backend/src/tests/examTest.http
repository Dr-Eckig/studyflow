###
@authToken = {{login.response.headers.Authorization}}
@userId = {{login.response.body.userId}}

@authToken2 = {{login2.response.headers.Authorization}}
@userId2 = {{login2.response.body.userId}}

###
GET {{host}}/exam
authorization: {{authToken}}

###
GET {{host}}/exam?start=2025-07-18&end=2025-07-20
authorization: {{authToken}}

###
# @name exam
POST {{host}}/exam
authorization: {{authToken}}
Content-Type: application/json

{
  "title": "Mathematik",
  "deadline": "2025-08-15",
  "tagColor": "red",
  "note": "Eine Klausur"
}

###
@examId = {{exam.response.body.id}}

###
GET {{host}}/exam
authorization: {{authToken}}

###
